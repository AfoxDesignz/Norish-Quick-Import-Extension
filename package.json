{
  "name": "norish-quick-import",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "build:chrome": "tsc -b && vite build --mode chrome",
    "build:firefox": "tsc -b && vite build --mode firefox",
    "zip:chrome": "node scripts/zip-dist.mjs chrome",
    "zip:firefox": "node scripts/zip-dist.mjs firefox",
    "zip:dist": "pnpm run zip:chrome && pnpm run zip:firefox",
    "sign:firefox": "node scripts/sign-firefox.mjs",
    "release:chrome": "pnpm run build:chrome && pnpm run zip:chrome",
    "release:firefox": "pnpm run build:firefox && pnpm run zip:firefox",
    "release:firefox:signed": "pnpm run build:firefox && pnpm run zip:firefox && pnpm run sign:firefox",
    "release:zip": "pnpm run build && pnpm run zip:dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@heroicons-animated/react": "1.3.0",
    "@heroicons/react": "2.2.0",
    "@heroui/react": "3.0.0-beta.6",
    "@heroui/styles": "3.0.0-beta.6",
    "@trpc/client": "11.10.0",
    "event-source-polyfill": "1.0.31",
    "motion": "12.34.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "superjson": "2.2.6",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@tailwindcss/vite": "4.2.0",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react": "5.1.4",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.24",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.56.0",
    "vite": "7.3.1",
    "vitest": "5.1.0",
    "web-ext": "^10.8.0"
  }
}
